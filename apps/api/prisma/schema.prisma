generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  RESTAURANT_ADMIN
  MANAGER
  CASHIER
  WAITER
  KITCHEN
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model Restaurant {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  slug          String         @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  branches      Branch[]
  users         User[]
  subscriptions Subscription[]
  menuCategories MenuCategory[]
  menuItems     MenuItem[]
  tables        RestaurantTable[]
  orders        Order[]
  invoices      Invoice[]
  payments      Payment[]

  @@map("restaurants")
}

model Branch {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @db.Uuid
  name         String
  code         String
  isActive     Boolean  @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  users        User[]
  tables       RestaurantTable[]
  orders       Order[]
  invoices     Invoice[]
  payments     Payment[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@map("branches")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String?    @db.Uuid
  branchId     String?    @db.Uuid
  role         UserRole
  firstName    String
  lastName     String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  authSessions AuthSession[]

  @@index([restaurantId])
  @@index([branchId])
  @@map("users")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  restaurantId         String             @db.Uuid
  planCode             String
  status               SubscriptionStatus
  currentPeriodStartAt DateTime
  currentPeriodEndAt   DateTime
  canceledAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@map("subscriptions")
}

enum MenuItemType {
  FOOD
  BEVERAGE
  ADDON
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum OrderStatus {
  DRAFT
  PLACED
  IN_PREPARATION
  READY
  SERVED
  COMPLETED
  CANCELED
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model MenuCategory {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @db.Uuid
  name         String
  slug         String
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id             String       @id @default(uuid()) @db.Uuid
  restaurantId   String       @db.Uuid
  menuCategoryId String       @db.Uuid
  name           String
  sku            String?
  description    String?
  type           MenuItemType
  price          Decimal      @db.Decimal(12, 2)
  taxRate        Decimal      @default(0) @db.Decimal(5, 2)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuCategory   MenuCategory @relation(fields: [menuCategoryId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]

  @@unique([restaurantId, sku])
  @@index([restaurantId, menuCategoryId])
  @@map("menu_items")
}

model RestaurantTable {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @db.Uuid
  branchId     String?     @db.Uuid
  name         String
  code         String
  capacity     Int
  status       TableStatus @default(AVAILABLE)
  qrCodeValue  String?
  sortOrder    Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orders       Order[]

  @@unique([restaurantId, code])
  @@index([restaurantId, branchId, status])
  @@map("tables")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  restaurantId   String      @db.Uuid
  branchId       String?     @db.Uuid
  tableId        String?     @db.Uuid
  orderNumber    String
  status         OrderStatus @default(DRAFT)
  notes          String?
  subtotalAmount Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal     @default(0) @db.Decimal(12, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  restaurant     Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch         Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  table          RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  invoice        Invoice?

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, branchId, status])
  @@map("orders")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  restaurantId   String        @db.Uuid
  branchId       String?       @db.Uuid
  orderId        String        @unique @db.Uuid
  invoiceNumber  String
  status         InvoiceStatus @default(OPEN)
  subtotalAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  issuedAt       DateTime      @default(now())
  dueAt          DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@unique([restaurantId, invoiceNumber])
  @@index([restaurantId, status, issuedAt])
  @@map("invoices")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  restaurantId String        @db.Uuid
  branchId     String?       @db.Uuid
  invoiceId    String        @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  status       PaymentStatus @default(SUCCESS)
  reference    String?
  paidAt       DateTime      @default(now())
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([restaurantId, invoiceId])
  @@map("payments")
}

model OrderItem {
  id           String    @id @default(uuid()) @db.Uuid
  orderId      String    @db.Uuid
  menuItemId   String    @db.Uuid
  quantity     Int
  unitPrice    Decimal   @db.Decimal(12, 2)
  taxAmount    Decimal   @default(0) @db.Decimal(12, 2)
  lineTotal    Decimal   @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem     MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model AuthSession {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  refreshTokenHash String
  userAgent       String?
  ipAddress       String?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}
