# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=restaurantpos
POSTGRES_USER=posuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── API ────────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHAR_HEX
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_HEX_DIFFERENT

# Allowed CORS origins (comma-separated). Add your domain(s):
# For the Electron desktop apps, use '*' or your api domain.
CORS_ORIGIN=https://api.yourdomain.com

# ── Master Admin ───────────────────────────────────────────────────────────────
# The URL the master-admin SPA should call (baked in at build time)
MASTER_ADMIN_API_URL=https://api.yourdomain.com
